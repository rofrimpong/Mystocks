APP_NAME="MyStocks"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Accra

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - PostgreSQL recommended
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mystocks
DB_USERNAME=mystocks
DB_PASSWORD=

# Fallback MySQL (uncomment and set DB_CONNECTION=mysql if needed)
# DB_CONNECTION=mysql
# DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=mystocks_

# Redis (optional - leave as is for database fallback)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mystocks.app"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum / API
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,::1

# Frontend URL (for CORS and emails)
FRONTEND_URL=http://localhost:5173

# MyStocks specific
MYSTOCKS_DEFAULT_CURRENCY=GHS
MYSTOCKS_DEFAULT_COUNTRY=GH
MYSTOCKS_DEFAULT_TIMEZONE=Africa/Accra
MYSTOCKS_ALLOW_NEGATIVE_STOCK=false
MYSTOCKS_LOW_STOCK_NOTIFICATION=true

# Platform Admin
PLATFORM_ADMIN_EMAIL=admin@cnmg.tech

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
